# ==========================
# Application
# ==========================
APP_NAME=Data Science Job Market Intelligence Platform
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# ==========================
# Environment
# ==========================
ENVIRONMENT=development
DEBUG=True

# ==========================
# Database
# ==========================
DATABASE_URL=postgresql://username:password@localhost:5432/job_market_db

# ==========================
# Security
# ==========================
SECRET_KEY=replace_this_with_a_secure_random_key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================
# CORS
# ==========================
BACKEND_CORS_ORIGINS=http://localhost:3000